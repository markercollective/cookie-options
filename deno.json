{
  "name": "@marker/cookie-options",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./src/mod.ts",
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check",
    "test": "deno test --allow-env",
    "bundle": "deno bundle --platform browser --minify src/mod.ts -o dist/cookie-options.js",
    "release": "deno run --allow-read --allow-write --allow-run scripts/release.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "happy-dom": "npm:happy-dom@^20"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"]
  },
  "exclude": ["dist"],
  "publish": {
    "exclude": ["src/*_test.ts", "scripts", "example", ".github"]
  }
}
